{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalDependencies": ["tsconfig.base.json", "eslint.config.js"],
  "globalEnv": ["NODE_ENV"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"],
      "env": ["SUPABASE_URL", "SUPABASE_ANON_KEY", "NEXT_PUBLIC_*"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "typecheck": {},
    "test": {
      "outputs": ["coverage/**"],
      "env": ["DATABASE_URL", "REQUIRE_DB_TESTS", "REDIS_URL"]
    },
    "evals": {
      "cache": false
    },
    "@nurion/db#test": {
      "cache": false,
      "env": ["DATABASE_URL", "REQUIRE_DB_TESTS"]
    }
  }
}
