# Supabase (Project Settings > API). A service role key fica só no servidor.
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Senha do painel
ADMIN_PASSWORD=troque-esta-senha

# Meta: token que você inventa e cola no painel de Webhooks da Meta
META_VERIFY_TOKEN=um-token-qualquer
# App secret do app Meta (Messenger/WhatsApp). Para Instagram Login o app secret
# do Instagram pode ser diferente: separe vários por vírgula.
META_APP_SECRETS=
META_GRAPH_VERSION=v21.0

# Protege /api/cron/tick (Vercel envia "Authorization: Bearer $CRON_SECRET")
CRON_SECRET=
