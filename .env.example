# ---- Supabase (supabase start imprime os valores locais) ----
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
# Só api e worker. Nunca no web.
SUPABASE_SERVICE_ROLE_KEY=
# Conexão direta ao Postgres (testes de RLS e scripts). Local: porta 54322.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# ---- Redis / filas ----
REDIS_URL=redis://localhost:6379
QUEUE_PREFIX=nurion
WORKER_CONCURRENCY=10

# ---- IA (modelos SEMPRE por env, nunca no código) ----
ANTHROPIC_API_KEY=
LLM_MODEL_AGENT=claude-sonnet-5-5
LLM_MODEL_FAST=claude-haiku-5-5
LLM_MODEL_VISION=claude-sonnet-5-5
# Preço por milhão de tokens, em USD, por modelo (JSON). Usado para ai_runs.cost_usd.
# Ex.: {"claude-sonnet-5-5":{"input":3,"output":15,"cache_read":0.3,"cache_write":3.75}}
LLM_PRICING=

EMBEDDINGS_PROVIDER=openai
EMBEDDINGS_API_KEY=
EMBEDDINGS_MODEL=text-embedding-3-small
EMBEDDINGS_BASE_URL=
EMBEDDINGS_DIMENSIONS=1536

GROQ_API_KEY=
TRANSCRIPTION_MODEL=whisper-large-v3-turbo

# ---- WhatsApp Cloud API ----
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_GRAPH_VERSION=v23.0
# Só para ferramentas locais que simulam a Graph API
WHATSAPP_GRAPH_BASE_URL=

# ---- Chatwoot (handoff no MVP) ----
CHATWOOT_URL=
CHATWOOT_API_TOKEN=

# ---- Segurança ----
# openssl rand -base64 32
ENCRYPTION_KEY=
# Só durante rotação de chave (docs/runbooks/rotacao-de-chaves.md)
ENCRYPTION_KEY_PREVIOUS=

# ---- Observabilidade ----
SENTRY_DSN=
LOG_LEVEL=info

# ---- Endereços ----
API_PORT=4000
WORKER_HEALTH_PORT=4100
WEB_URL=http://localhost:3000
API_URL=http://localhost:4000
