{
  "name": "@nurion/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "build": "node ../../scripts/build-node-app.mjs src/index.ts",
    "start": "node dist/index.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "ops": "tsx --env-file-if-exists=../../.env src/cli.ts"
  },
  "dependencies": {
    "@nurion/core": "workspace:*",
    "@nurion/db": "workspace:*",
    "@nurion/module-adm": "workspace:*",
    "@nurion/module-consult": "workspace:*",
    "@nurion/module-labs": "workspace:*",
    "@nurion/module-log": "workspace:*",
    "@nurion/shared": "workspace:*",
    "@nurion/whatsapp": "workspace:*",
    "bullmq": "5.81.5",
    "ioredis": "5.11.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/pg": "8.15.6",
    "pg": "8.16.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
